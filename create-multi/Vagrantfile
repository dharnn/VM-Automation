
require "json"

# 1. Find the JSON configuration file

config_file = File.join(__dir__, "vm.json")

unless File.exist?(config_file)
  abort "vm.json not found. Run create-multi-vm.ps1 first."
end

# 2. Read the VM configuration

data = JSON.parse(File.read(config_file))
vms = data.fetch("vms")

unless vms.is_a?(Array) && !vms.empty?
  abort "No virtual machines are defined."
end

# 3. Configure Vagrant

Vagrant.configure("2") do |config|

  config.vm.box = "bento/ubuntu-22.04"
  config.vm.box_check_update = false
  config.vm.boot_timeout = 600

  config.vm.synced_folder ".", "/vagrant", disabled: true

  # 4. Create each VM from the JSON configuration

  vms.each do |vm|

    name = vm.fetch("name")

    config.vm.define name do |machine|

      machine.vm.hostname = name

      machine.vm.provider "virtualbox" do |vb|

        vb.name = name
        vb.cpus = Integer(vm.fetch("cpus"))
        vb.memory = Integer(vm.fetch("memory"))

        vb.linked_clone = true

      end
    end
  end
end
